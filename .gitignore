# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key

# Dependency directories
node_modules/
dashboard/node_modules/
projects/*/web/node_modules/
projects/*/mobile/node_modules/

# Ignore nested git repositories inside generated app projects
projects/*/*/.git
projects/*/*/*/.git

# Production build outputs & caches
dist/
dashboard/dist/
projects/*/web/dist/
projects/*/mobile/.expo/
.cache/
.vite/

# Binary artifacts & large files
*.apk
*.zip
*.tar.gz

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# System files
.DS_Store
Thumbs.db
